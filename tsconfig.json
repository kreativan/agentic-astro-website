{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "create"
  ],
  "compilerOptions": {
    "allowJs": true,
    "maxNodeModuleJsDepth": 5,
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    }
  }
}
