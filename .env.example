# Production URL. Used for canonical URLs, Open Graph URLs and the sitemap.
SITE_URL="https://example.com"

# <html lang>. Defaults to "en".
SITE_LANG="en"

# Site name: used in page titles ("Page | Site name"), og:site_name and the footer.
SITE_NAME="Agentic Astro Website"

# Fallback meta description and social image for pages that don't set their own.
# SITE_IMAGE is a path in public/ (e.g. /og/default.jpg) or an absolute URL, ideally 1200x630.
SITE_DESCRIPTION=""
SITE_IMAGE=""

# 1 = SSR with the Node adapter (npm run start), 0 = static build.
ASTRO_SSR=0
