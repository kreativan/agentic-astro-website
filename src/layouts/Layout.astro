---
/**
 * Page layout: <head>, header, <main> and footer. Pages render only their sections inside it.
 *
 * <Layout
 *    title="Page Title"
 *    description="Page Description"
 *    image="/og/page.jpg"
 *    type="article"
 *    scripts={["/js/one.js"]}     // files in public/, loaded with defer
 *    styles={["/css/one.css"]}    // files in public/
 *    noindex
 * >
 *    <Hero />
 * </Layout>
 *
 * title, description, image, canonical, type and noindex are passed to Meta.astro.
 */

import "@src/assets/fonts/inter.css";
import "@src/styles/global.css";
import { SITE_LANG } from "astro:env/server";
import Meta from "@src/components/global/Meta.astro";
import Header from "@src/components/global/Header.astro";
import Footer from "@src/components/global/Footer.astro";

const { title, description, image, canonical, type, scripts = [], styles = [], noindex } = Astro.props;
---

<html lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Meta
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
      noindex={noindex}
    />

    {styles.map((style: string) => <link rel="stylesheet" href={style} />)}
    {scripts.map((script: string) => <script is:inline src={script} defer />)}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
